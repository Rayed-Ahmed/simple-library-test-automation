# Base URL must point to the folder containing login.php
BASE_URL=http://localhost:8080/simple-online-library-system
BROWSER=chrome
HEADLESS=false
IMPLICIT_WAIT=0
EXPLICIT_WAIT=10

# Default admin account from l_db.sql
ADMIN_EMAIL=admin@library.com
ADMIN_PASSWORD=admin123

# Create a student account in the application and provide its credentials
STUDENT_EMAIL=
STUDENT_PASSWORD=

# Pause in seconds around browser navigation, clicks, and typing (0 disables slow motion)
SLOW_MO=0.7
